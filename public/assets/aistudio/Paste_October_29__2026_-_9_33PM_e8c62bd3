// FILM DETAILS: small client-side pages reached from hero and PROGRAMS
function route(){
 const hash=decodeURIComponent(location.hash.slice(1));
 const film=films.find(f=>'film-'+f.id===hash);
 if(film){
  site.classList.add('hidden');detail.classList.add('active');
  detail.innerHTML='<button class="back" type="button" id="filmBack">← ALL PROGRAMS</button>'+
   '<h1>'+esc(film.title)+'</h1><div class="detail-ko">'+esc(film.titleKo||'')+'</div>'+
   '<div class="byline">A FILM BY '+esc((film.director||'').toUpperCase())+' · '+esc(film.year||'')+'</div>'+
   '<img class="still" src="'+esc(film.heroImage||'images/hero-fallback-1.jpg')+'" alt="'+esc(film.title)+'">'+
   '<div class="details"><p>'+esc(film.summary||'')+'</p><aside>DIRECTOR — '+esc(film.director||'')+'<br>YEAR — '+esc(film.year||'')+'</aside></div>';
  detail.querySelector('#filmBack').addEventListener('click',()=>{location.hash='programs';});
  window.scrollTo(0,0);
 }else{
  const wasActive=detail.classList.contains('active');
  detail.classList.remove('active');site.classList.remove('hidden');
  if(wasActive){requestAnimationFrame(()=>{const t=document.getElementById(hash);if(t)t.scrollIntoView();});}
 }
}
window.addEventListener('hashchange',route);route();

// Magnetic poster hover (desktop)
const poster=document.getElementById('hoverPoster'),image=document.getElementById('hoverImg');
let active=false,animation=null,targetX=0,targetY=0,curX=0,curY=0,targetR=-4,curR=-4;
function animatePoster(){
 curX+=(targetX-curX)*.16;curY+=(targetY-curY)*.16;curR+=(targetR-curR)*.12;
 poster.style.left=curX+'px';poster.style.top=curY+'px';poster.style.setProperty('--r',curR+'deg');
 if(active||Math.abs(targetX-curX)>.2||Math.abs(targetY-curY)>.2||Math.abs(targetR-curR)>.2)animation=requestAnimationFrame(animatePoster);
 else animation=null;
}
function ensure(){if(!animation)animation=requestAnimationFrame(animatePoster);}
for(const row of filmList.querySelectorAll('.film-row')){
 const f=byId[row.dataset.key];if(!f)continue;
 row.addEventListener('mouseenter',e=>{
  image.src=f.posterImage||'images/sample-poster.jpg';poster.classList.add('visible');active=true;
  targetX=curX=clamp(e.clientX+150,160,innerWidth-160);
  targetY=curY=clamp(e.clientY+170,170,innerHeight-170);ensure();
 });
 row.addEventListener('mousemove',e=>{
  const x=clamp(e.clientX+150,160,innerWidth-160),y=clamp(e.clientY+170,170,innerHeight-170);
  targetR=clamp((x-targetX)*.06,-8,8);targetX=x;targetY=y;ensure();
 });
 row.addEventListener('mouseleave',()=>{active=false;targetR=-4;poster.classList.remove('visible');ensure();});
}

// Curtain + subtle lens movement (no cinematic cursor).
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
let pending=false;
function paint(){
 pending=false;
 if(detail.classList.contains('active'))return;
 scenes.forEach((scene,index)=>{
  if(reducedMotion.matches){scene.style.setProperty('--curtain-cut','0%');scene.style.setProperty('--curtain-shade','0');scene.style.setProperty('--zoom','1');scene.style.setProperty('--shift','0px');scene.style.setProperty('--text-shift','0px');scene.style.setProperty('--text-opacity','1');return;}
  const vh=innerHeight||1, rect=scene.getBoundingClientRect(), entry=clamp(1-rect.top/vh,0,1);
  const wipe=index===0?0:(1-entry)*(1-entry)*11;
  const shade=index===0?0:(1-entry)*.30;
  const proximity=clamp((rect.top+rect.height*.5-vh*.5)/vh,-1,1);
  const zoom=1.025+entry*.02;
  scene.style.setProperty('--curtain-cut',wipe.toFixed(2)+'%');scene.style.setProperty('--curtain-shade',shade.toFixed(3));
  scene.style.setProperty('--zoom',zoom.toFixed(4));scene.style.setProperty('--shift',clamp(-proximity*7,-7,7).toFixed(2)+'px');
  const p=clamp((rect.top-vh*.14)/vh,-1,1);
  scene.style.setProperty('--text-shift',(p*18).toFixed(1)+'px');scene.style.setProperty('--text-opacity',String(Math.max(.72,1-Math.abs(p)*.16)));
 });
}
function requestPaint(){if(!pending){pending=true;requestAnimationFrame(paint);}}
window.addEventListener('scroll',requestPaint,{passive:true});window.addEventListener('resize',requestPaint,{passive:true});reducedMotion.addEventListener?.('change',requestPaint);paint();
})();


