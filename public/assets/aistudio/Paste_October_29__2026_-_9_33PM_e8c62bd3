(function(){
'use strict';
const data = window.LIGHTHOUSE_CONTENT || {};
const films = Array.isArray(data.films) ? data.films : [];
const byId = Object.fromEntries(films.map(f => [f.id,f]));
const esc = value => String(value == null ? '' : value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const clamp = (v,min,max) => Math.min(max,Math.max(min,v));
const site=document.getElementById('site');
const detail=document.getElementById('detail');

// MAIN: choose any 3 film IDs from content.js
const scenes=[...document.querySelectorAll('.features > .feature')];
const ids = (data.featured||[]).slice(0,3);
scenes.forEach((scene,i)=>{
 const f=byId[ids[i]];
 if(!f){scene.hidden=true;return;}
 const bg=scene.querySelector('.bg');
 const fallback=bg.dataset.fallback || `images/hero-fallback-${i+1}.jpg`;
 bg.src=f.heroImage||fallback;
 bg.onerror=()=>{bg.onerror=null;bg.src=fallback;};
 scene.querySelector('.feature-name').textContent=f.title;
 const nameKo=scene.querySelector('.feature-name-ko');
 nameKo.textContent=f.titleKo||'';
 if(f.release){const date=document.createElement('span');date.className='feature-release-inline';date.textContent=f.release;nameKo.append(date);}
 scene.querySelector('.feature-link').href='#film-'+encodeURIComponent(f.id);
 const clickArea=document.createElement('a');
 clickArea.className='feature-image-link';
 clickArea.href='#film-'+encodeURIComponent(f.id);
 clickArea.setAttribute('aria-label',f.title+' — View film details');
 scene.insertBefore(clickArea,scene.querySelector('.feature-bottom'));
});

// PROGRAMS: the 7-at-a-time list, generated exclusively from content.js
const filmList=document.getElementById('film-list');
filmList.replaceChildren();
films.forEach((f,i)=>{
 const row=document.createElement('a');
 row.className='film-row';row.href='#film-'+encodeURIComponent(f.id);row.dataset.key=f.id;
 row.innerHTML='<span class="title-wrap"><span class="title">'+esc(f.title)+'</span><span class="title-ko">'+esc(f.titleKo)+'</span></span><span class="info">'+esc((f.director||'').toUpperCase())+' · '+esc(f.year||'')+' ↗</span>';
 if(i>=7)row.style.display='none';
 filmList.append(row);
});
const more=document.getElementById('moreFilms');
function updateMore(){if(more)more.hidden=![...filmList.children].some(row=>row.style.display==='none');}
