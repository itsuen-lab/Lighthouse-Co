<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="100%" height="100%">
  <defs>
    <linearGradient id="promoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#181818"/>
      <stop offset="40%" stop-color="#101010"/>
      <stop offset="100%" stop-color="#050505"/>
    </linearGradient>
    <radialGradient id="beamGrad" cx="30%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.18"/>
      <stop offset="40%" stop-color="#ffffff" stop-opacity="0.04"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#promoGrad)"/>
  <!-- Beams of light representing lighthouse projector lens -->
  <polygon points="0,0 1200,400 1600,1080 0,1080" fill="url(#beamGrad)"/>
  <circle cx="500" cy="450" r="350" fill="#ffffff" fill-opacity="0.02"/>
  <circle cx="500" cy="450" r="180" fill="#ffffff" fill-opacity="0.04"/>
  <circle cx="500" cy="450" r="80" fill="#ffffff" fill-opacity="0.06"/>
</svg>
